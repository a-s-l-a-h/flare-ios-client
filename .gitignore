/fullcode
/fullcode/
fullcode/*
# ==============================================================================
# Temporary / Extra Folders
# ==============================================================================
fullcode/

# ==============================================================================
# OS & System Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# ==============================================================================
# Xcode & Build Artifacts
# ==============================================================================
# Build output & DerivedData
build/
DerivedData/
*.moved-aside
*.xcuserstate

# User-specific Xcode configuration (Never commit personal IDE layout/breakpoints)
xcuserdata/
*.xcuserdatad/

# Xcode temporary & interface files
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Keep shared Xcode Schemes so CI/GitHub Actions can find build targets
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3
!*.xcworkspace/xcshareddata/
!*.xcodeproj/xcshareddata/

# ==============================================================================
# Swift Package Manager (SPM)
# ==============================================================================
# Build cache directory generated by `swift build` or Xcode
.build/
.swiftpm/
.swiftpm/xcode/xcuserdata/

# Keep Package.resolved for fast, deterministic CI caching
!Package.resolved
!Package.pins

# ==============================================================================
# CocoaPods
# ==============================================================================
# Pods directory (CI will restore from cache or run `pod install`)
Pods/

# Keep Podfile.lock for deterministic CocoaPods dependency caching in CI
!Podfile.lock

# ==============================================================================
# Fastlane & CI Test Artifacts (GitHub Actions)
# ==============================================================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
*.log

# ==============================================================================
# Secrets & Environment Configuration
# ==============================================================================
*.env
*.env.*
*.p12
*.mobileprovision
*.cer
*.key
*.pem